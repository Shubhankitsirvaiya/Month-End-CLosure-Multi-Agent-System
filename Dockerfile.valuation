# A separate deployable image proves valuation is reached across an A2A boundary.
FROM python:3.12-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1
WORKDIR /app
# Dependency installation stays in a cacheable layer shared conceptually with API.
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt
# The remote service reuses governed specialist/tool code but has its own entrypoint.
COPY app app
COPY remote_agents remote_agents
COPY data data
# Least-privilege runtime user; the service does not need root capabilities.
RUN useradd --create-home appuser && chown -R appuser:appuser /app
USER appuser
EXPOSE 9000
# Port 9000 publishes Agent Card discovery and JSON-RPC task handling.
CMD ["uvicorn", "remote_agents.valuation_agent.app:app", "--host", "0.0.0.0", "--port", "9000"]
