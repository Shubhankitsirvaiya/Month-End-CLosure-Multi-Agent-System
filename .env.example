# Secret used by the required live OpenAI agents. Keep the committed example blank.
OPENAI_API_KEY=
# Chat model plans/expresses; embedding model represents policy text for retrieval.
OPENAI_MODEL=gpt-5-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# local uses TF-IDF; openai uses embeddings persisted in Chroma.
POLICY_RETRIEVAL_MODE=local
# 0.0.0.0 listens on all container interfaces; API_PORT publishes FastAPI locally.
API_HOST=0.0.0.0
API_PORT=8000
# URL used by the separately running Streamlit process.
STREAMLIT_API_URL=http://localhost:8000
# Public base URL of the remote A2A valuation specialist.
VALUATION_AGENT_URL=http://localhost:9000
# Advertised protocol contract and business-continuity behavior during downtime.
A2A_VERSION=1.0
A2A_FALLBACK_LOCAL=true
# Source, runtime, policy, and evaluation-label locations relative to project root.
DATA_ROOT=data
RUNTIME_ROOT=runtime
POLICY_ROOT=data/policies
GROUND_TRUTH_ROOT=data/ground_truth
# Optional external trace export; false keeps observability local.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=project-16-month-end-copilot
# Safety budgets: bounded rounds/retries, approval materiality, confidence escalation.
MAX_ORCHESTRATOR_ROUNDS=6
MAX_AGENT_RETRIES=2
MATERIALITY_APPROVAL_BPS=10
LOW_CONFIDENCE_THRESHOLD=0.72

